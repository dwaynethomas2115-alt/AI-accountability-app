{
  "expo": {
    "name": "Kindred",
    "slug": "ai-accountability-companion",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kindred.accountability",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kindred uses your microphone only when you start a voice conversation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kindred.accountability",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kindred",
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "./src/lib/voice/withAudioOnlyWebRTC.js",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Kindred uses your microphone only when you start a voice conversation."
        }
      ]
    ]
  }
}
